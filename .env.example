# Export these variables in the process environment before running the CLI.
# NET_CONNECTOR_CONFIG=./config.yml
NETDISCO_URL=https://netdisco.example
NETDISCO_USERNAME=inventory-reader
NETDISCO_PASSWORD=replace-me

NET_CONNECTOR_DEVICE_USERNAME=backup-user
NET_CONNECTOR_DEVICE_PASSWORD=replace-me
NET_CONNECTOR_BACKUP_DIRECTORY=./backups
NET_CONNECTOR_CONCURRENCY=4
# NET_CONNECTOR_ALL=1

# Optional inventory filters and overrides:
# NET_CONNECTOR_INCLUDE_HOSTS=192.0.2.10,192.0.2.11
# NET_CONNECTOR_INCLUDE_VENDORS=h3c,h3c_wireless,cisco_ios,cisco_nxos,radware,palo_alto,huawei,hillstone
# NET_CONNECTOR_TFTP_VRFS={"cisco_nxos":"management","hillstone":"mgt-vr"}
# NET_CONNECTOR_VENDOR_OVERRIDES={"Custom Vendor":"huawei"}
# NET_CONNECTOR_HOST_OVERRIDES={"192.0.2.253":"h3c_wireless"}
# NET_CONNECTOR_DEVICE_RULES=[{"vendor":"Cisco","model_prefix":"N9K","connector":"cisco_nxos"}]

# Optional SSH and logging settings:
# NET_CONNECTOR_KNOWN_HOSTS=/etc/net-connector/known_hosts
# NET_CONNECTOR_HOST_KEY_POLICY=strict
# NET_CONNECTOR_LOG_DIRECTORY=./logs
# NET_CONNECTOR_LOG_LEVEL=debug
