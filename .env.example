# Examples load project-root .env; existing process variables take precedence.
# CLI reads process variables; use --config FILE or NC_CONFIG for YAML.
NETDISCO_URL=https://netdisco.example
NETDISCO_USERNAME=inventory-reader
NETDISCO_PASSWORD=replace-me
NC_DEVICE_USERNAME=backup-user
NC_DEVICE_PASSWORD=replace-me
NC_BACKUP_DIRECTORY=./examples/backups
NC_CONCURRENCY=4
# Optional sampling; omit for full inventory.
# NC_SAMPLE_PER_VENDOR=3
# Live progress on STDERR; STDOUT remains JSON.
NC_PROGRESS=1
# Optional non-secret filters, mappings, budgets and TFTP settings:
# NC_CONFIG=./examples/backup.yml
# For database inventory see examples/inventory_sql.yml and README.md.

# Trust and persist first-seen keys; reject changed keys.
NC_HOST_KEY_POLICY=accept_new
# TFTP_HOST=192.0.2.10
# Optional local or mounted TFTP server root for verified, per-batch history.
# TFTP_ROOT=/srv/tftp
