# 示例读取项目根目录 .env；已有进程环境变量优先。
# CLI 读取进程环境；其他公开策略使用 YAML 或 CLI 选项。
NC_CONCURRENCY=4
# 清单缓存有效期，单位秒；默认三天，须为有限正数。
ND_CACHE_TTL=259200
NC_CONFIG=./examples/backup.yml
ND_URL=https://netdisco.example
ND_USERNAME=inventory-reader
ND_PASSWORD=replace-me
NC_DEVICE_USERNAME=backup-user
NC_DEVICE_PASSWORD=replace-me
# 已有 API 密钥时用 ND_API_KEY 替代 ND_USERNAME / ND_PASSWORD。
# 可选提权凭据或厂商凭据：
# NC_ENABLE_PASSWORD=replace-me
# NC_CISCO_IOS_USERNAME=backup-user
# NC_CISCO_IOS_PASSWORD=replace-me
# 使用 PostgreSQL 清单时，改为提供数据库身份：
# ND_DB_HOST=database.example
# ND_DB_NAME=netdisco
# ND_DB_USER=inventory-reader
# ND_DB_PASS=replace-me
# 来源、SQL、端口和 TLS 设置见 examples/inventory_sql.yml。
