# 复制或合并到项目根目录 .env；不要把真实凭据提交到版本库。
# 示例层优先级：CLI > YAML > 这些环境默认值。
ND_URL=https://netdisco.example.invalid
ND_USERNAME=inventory-reader
ND_PASSWORD=replace-me
NC_DEVICE_USERNAME=backup-user
NC_DEVICE_PASSWORD=replace-me
# NC_ENABLE_PASSWORD=replace-me

NC_BACKUP_DIRECTORY=./examples/backups
NC_CONCURRENCY=4
NC_HOST_KEY_POLICY=accept_new
NC_KNOWN_HOSTS=~/.ssh/known_hosts
ND_CACHE_TTL=259200
# 公开配置字段使用 ConfigFile 的规范环境键；YAML 已声明的字段优先。
# NC_TFTP_HOST=192.0.2.10
# NC_TFTP_ROOT=/srv/tftp
# NC_TFTP_SOURCE_INTERFACES={"h3c":{"default":"management","hosts":{}}}
# PostgreSQL 身份仍作为凭据保留，不进入 YAML：
# ND_DB_HOST=db.example.invalid
# ND_DB_NAME=inventory
# ND_DB_USER=inventory-reader
# ND_DB_PASS=replace-me
